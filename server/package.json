{
  "name": "js-flights",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "watch": "node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types src/db/seed.ts",
    "db:setup": "npm run db:migrate & npm run db:seed"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}